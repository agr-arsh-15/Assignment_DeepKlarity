# ==========================================
# Recipe Extractor - Environment Variables
# ==========================================

# ------------------------------------------
# LLM Provider Configuration
# Choose your preferred LLM provider by populating the corresponding API key.
# Supported providers: Groq (default), OpenAI, Google Gemini, Ollama
# ------------------------------------------

# Option 1: Groq (Recommended - Fast & Free tier available at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=your_openai_api_key_here

# Option 3: Google Gemini (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here

# Option 4: Local Ollama (No API Key required, set LLM_PROVIDER=ollama)
# LLM_PROVIDER=ollama

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# PostgreSQL (Default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipe_db

# SQLite Fallback (Auto-used if DATABASE_URL is not set or PostgreSQL is unavailable)
# DATABASE_URL=sqlite:///./recipes.db
